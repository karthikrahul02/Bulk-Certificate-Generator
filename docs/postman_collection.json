{
  "info": {
    "name": "Bulk Certificate Generator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "jobId", "value": "" },
    { "key": "recipientId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Create Certificate Job",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\"event_name\":\"Backend Cohort\",\"course_name\":\"FastAPI Fundamentals\",\"issued_on\":\"2026-10-07\",\"recipients\":[{\"name\":\"Asha Rao\",\"email\":\"asha@example.com\"},{\"name\":\"Dev Patel\",\"email\":\"dev@example.com\",\"certificate_title\":\"Certificate of Excellence\"}]}"
        }
      }
    },
    {
      "name": "List Jobs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/jobs"
      }
    },
    {
      "name": "Get Job Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/jobs/{{jobId}}"
      }
    },
    {
      "name": "Download Certificate",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/jobs/{{jobId}}/certificates/{{recipientId}}"
      }
    }
  ]
}
